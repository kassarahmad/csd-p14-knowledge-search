{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p14.example/contracts/v1/Problem.json",
  "description": "RFC 9457 problem details.",
  "properties": {
    "type": {
      "default": "about:blank",
      "title": "Type",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "integer"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "instance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instance"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "title": "Problem",
  "type": "object"
}
