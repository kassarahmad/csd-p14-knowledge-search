{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p14.example/contracts/v1/SearchRequest.json",
  "$defs": {
    "SearchFilters": {
      "additionalProperties": false,
      "properties": {
        "office": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Office"
        },
        "type": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "source_id": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "title": "SearchFilters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "top_k": {
      "default": 10,
      "description": "Number of passages to return.",
      "maximum": 50,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    },
    "filters": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchFilters"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "with_summary": {
      "default": true,
      "title": "With Summary",
      "type": "boolean"
    }
  },
  "required": [
    "query"
  ],
  "title": "SearchRequest",
  "type": "object"
}
